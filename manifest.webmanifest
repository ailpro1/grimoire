{
  "name": "GRIMOIRE - Scrolls, Chronicle & Quests",
  "short_name": "Grimoire",
  "description": "An 8-bit medieval keeper of notes, journal entries and to-do quests. Everything stays on your own device.",
  "start_url": "./index.html#/keep",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#14101f",
  "theme_color": "#1a1226",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "lifestyle", "utilities"],
  "icons": [
    { "src": "icons/icon-32.png",  "sizes": "32x32",   "type": "image/png" },
    { "src": "icons/icon-64.png",  "sizes": "64x64",   "type": "image/png" },
    { "src": "icons/icon-180.png", "sizes": "180x180", "type": "image/png" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Today's entry",
      "short_name": "Chronicle",
      "url": "./index.html#/chronicle",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Quest board",
      "short_name": "Quests",
      "url": "./index.html#/quests",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Scrolls",
      "short_name": "Scrolls",
      "url": "./index.html#/scrolls",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
